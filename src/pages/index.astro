---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import WritingCard from '../components/WritingCard.astro';
import { selectedPublications } from '../data/publications';
import { siteContent } from '../data/site-content';
import { siteConfig } from '../config/site';
import Introduction from '../content/home-introduction.md';
import { Mail, GraduationCap } from '@lucide/astro';
import { faGithub } from '@fortawesome/free-brands-svg-icons';

const githubViewBox = `0 0 ${faGithub.icon[0]} ${faGithub.icon[1]}`;
const githubPath = faGithub.icon[4] as string;

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const homePosts = posts.slice(0, siteContent.home.writingLimit);
---

<BaseLayout>
  <section class="hero" style={`--portrait-size: ${siteConfig.portraitSize}px`}>
    <div class="hero-copy">
      <h1>{siteContent.profile.name}</h1>
      <div class="lede"><Introduction /></div>
      {siteContent.home.showSupportingIntroduction && <p>{siteContent.home.supporting}</p>}
      <div class="hero-links" aria-label="Contact and profile links">
        <a href={`mailto:${siteContent.profile.email}`}><Mail aria-hidden="true" />Email</a>
        <a href={siteContent.profile.scholar}><GraduationCap aria-hidden="true" />Google Scholar</a>
        <a href={siteContent.profile.github}>
          <svg aria-hidden="true" viewBox={githubViewBox}><path d={githubPath}></path></svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="portrait-wrap">
      <img class="portrait" src={siteContent.profile.portrait} alt={siteContent.profile.portraitAlt} width="480" height="600" />
    </div>
  </section>

  {siteContent.home.showResearchSection && (
    <section class="section-block" aria-labelledby="research-heading">
      <h2 id="research-heading">{siteContent.home.researchHeading}</h2>
      <p>{siteContent.home.research}</p>
    </section>
  )}

  {homePosts.length > 0 && (
    <section class="section-block" aria-labelledby="writing-heading">
      <h2 id="writing-heading">{siteContent.home.writingHeading}</h2>
      {homePosts.map((post) => <WritingCard post={post} featured />)}
      <p><a class="text-link" href="/writing/">{siteContent.home.writingLink}</a></p>
    </section>
  )}

  <section class="section-block" aria-labelledby="papers-heading">
    <h2 id="papers-heading">{siteContent.home.publicationsHeading}</h2>
    <div class="publication-list">
      {selectedPublications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
    <p><a class="text-link" href="/publications/">{siteContent.home.publicationsLink}</a></p>
  </section>
</BaseLayout>
