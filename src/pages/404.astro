---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent } from '../data/site-content';
---

<BaseLayout title={`${siteContent.notFoundPage.title} — ${siteContent.profile.name}`} description={siteContent.notFoundPage.description}>
  <section class="page-intro missing-page">
    <p class="eyebrow">404</p>
    <h1>{siteContent.notFoundPage.heading}</h1>
    <p class="lede">{siteContent.notFoundPage.message}</p>
    <p><a class="text-link" href="/">{siteContent.notFoundPage.link}</a></p>
  </section>
</BaseLayout>
